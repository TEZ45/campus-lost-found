APP_ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=development-only-replace-before-deployment

# Local default. PostgreSQL uses the DB_* values below when selected.
DB_ENGINE=sqlite
DB_NAME=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=campus_runtime
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000

# Shared Redis primary is required when DEBUG=False. Do not use replicas.
REQUEST_LIMITS_REDIS_URL=
REQUEST_LIMITS_KEY_PREFIX=campus-lost-found
REQUEST_LIMITS_TRUSTED_PROXIES=
TRUST_PROXY_HTTPS=False
CSRF_TRUSTED_ORIGINS=
REQUEST_MAX_BODY_BYTES=17825792
REQUEST_MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_PIXELS=20000000

# Set this to the actually provisioned attachment budget, excluding backups.
STORAGE_CAPACITY_BYTES=107374182400
MATCH_MAX_PAIRS=2500
MATCH_MAX_SECONDS=10
MATCH_COOLDOWN_SECONDS=30
