# Inject into the process environment. Production does not load the root .env.
APP_ENV=production
DEBUG=False
SECRET_KEY=replace-with-a-random-production-secret
ALLOWED_HOSTS=lost-found.example.edu
DB_ENGINE=postgresql
DB_NAME=campus
DB_HOST=db.example.edu
DB_PORT=5432
DB_USER=campus_runtime
DB_PASSWORD=replace-with-a-random-database-password
DB_SSLMODE=verify-full
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
REQUEST_LIMITS_REDIS_URL=rediss://redis.example.edu:6379/0
REQUEST_LIMITS_KEY_PREFIX=campus-production
REQUEST_LIMITS_TRUSTED_PROXIES=
TRUST_PROXY_HTTPS=False
CSRF_TRUSTED_ORIGINS=
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
MEDIA_ROOT=/srv/campus/media
PRIVATE_MEDIA_ROOT=/srv/campus/private_media
STATIC_ROOT=/srv/campus/staticfiles
